# Kopieren nach .env und ausfüllen. Ohne Schlüssel läuft alles regelbasiert (kostenlos).

# --- Empfohlen für den Prototyp: Google Gemini ---
# Schlüssel kostenlos unter https://aistudio.google.com/apikey erstellen und hier eintragen.
# Mehr ist nicht nötig: Adresse und Modell (gemini-flash-latest, sonst automatisch ein verfügbares Flash-Modell) werden gesetzt.
GEMINI_API_KEY=

# --- Alternative: anderer Anbieter (OpenAI-kompatibel). Hat Vorrang vor GEMINI_API_KEY. ---
# Mistral (EU):
# LLM_API_KEY=
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest
# IONOS (Deutschland):
# LLM_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
# Anderes Gemini-Modell: LLM_MODEL=gemini-...

# Preis pro 1 Mio. Tokens in $ (nur für den Kostenzähler im Dashboard, an das Modell anpassen)
LLM_PRICE_IN=0.15
LLM_PRICE_OUT=0.60
# Max. KI-Antworten im Chat pro Minute (schützt Kosten/Gratis-Kontingent, danach regelbasiert)
CHAT_MAX_PER_MIN=20

# Redaktion-Login (vor dem Teilen per Cloudflare ändern!)
ADMIN_USER=redaktion@beispiel.de
ADMIN_PASSWORD=demo1234
# Automatischer Durchlauf alle X Minuten
RUN_INTERVAL_MIN=60
# OFFLINE=1 schaltet Webquellen, Wetter und Karten ab (nur Beispieldaten)

# Optional: Region aus der IP schätzen (einmalig, ohne Speichern). Datei „IP to City Lite“ (mmdb) von db-ip.com,
# dazu: py -m pip install maxminddb
# GEOIP_DB=C:\oberfranken\dbip-city-lite.mmdb
